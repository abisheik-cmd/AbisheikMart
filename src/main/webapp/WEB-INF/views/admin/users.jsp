<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="activeNav" value="admin" scope="request" /><jsp:include page="/WEB-INF/views/common/header.jsp" /><jsp:include page="/WEB-INF/views/common/navbar.jsp" />
<main class="main-content"><div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;"><div><h2 style="color:#fff;">User Management</h2><p style="color:var(--text-secondary);">Passwords and password hashes are never rendered.</p></div><a class="btn btn-secondary" href="${pageContext.request.contextPath}/admin">← Dashboard</a></div>
<form method="get" action="${pageContext.request.contextPath}/admin/users" style="display:flex;gap:.6rem;flex-wrap:wrap;margin:1.3rem 0;"><input class="form-control" name="q" value="${param.q}" placeholder="Search name or email" style="max-width:260px;"><select class="form-control" name="role"><option value="ALL">All roles</option><option value="CUSTOMER">Buyer</option><option value="SELLER">Seller</option><option value="ADMIN">Admin</option></select><select class="form-control" name="active"><option value="ALL">All statuses</option><option value="true">Active</option><option value="false">Inactive</option></select><button class="btn btn-primary">Filter</button></form>
<div class="data-table"><table class="data-table"><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Created</th><th>Action</th></tr></thead><tbody><c:forEach items="${users}" var="user"><tr><td>${user.id}</td><td><a href="${pageContext.request.contextPath}/admin/users/view?id=${user.id}">${user.name}</a></td><td>${user.email}</td><td>${user.role}</td><td><span class="card-badge-stock ${user.active ? 'in-stock' : 'out-of-stock'}" style="position:static;">${user.active ? 'ACTIVE' : 'INACTIVE'}</span></td><td><fmt:formatDate value="${user.createdAt}" pattern="yyyy-MM-dd HH:mm" /></td><td><c:if test="${user.role ne 'ADMIN'}"><form method="post" action="${pageContext.request.contextPath}/admin/users/status"><input type="hidden" name="userId" value="${user.id}"><input type="hidden" name="active" value="${user.active ? 'false' : 'true'}"><button class="btn btn-sm ${user.active ? 'btn-danger' : 'btn-success'}">${user.active ? 'Deactivate' : 'Activate'}</button></form></c:if></td></tr></c:forEach></tbody></table></div>
</main><jsp:include page="/WEB-INF/views/common/footer.jsp" />
