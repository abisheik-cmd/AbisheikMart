<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="activeNav" value="admin" scope="request" /><jsp:include page="/WEB-INF/views/common/header.jsp" /><jsp:include page="/WEB-INF/views/common/navbar.jsp" />
<main class="main-content"><div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;"><div><h2 style="color:#fff;">Product Management</h2><p style="color:var(--text-secondary);">Deactivate listings without deleting historical order snapshots.</p></div><a class="btn btn-secondary" href="${pageContext.request.contextPath}/admin">← Dashboard</a></div>
<form method="get" action="${pageContext.request.contextPath}/admin/products" style="display:flex;gap:.6rem;flex-wrap:wrap;margin:1.3rem 0;"><input class="form-control" name="q" value="${param.q}" placeholder="Search product or seller" style="max-width:260px;"><select class="form-control" name="categoryId"><option value="">All categories</option><c:forEach items="${categories}" var="category"><option value="${category.id}" ${param.categoryId == category.id ? 'selected' : ''}>${category.name}</option></c:forEach></select><input class="form-control" name="sellerId" value="${param.sellerId}" placeholder="Seller ID" style="max-width:120px;"><select class="form-control" name="active"><option value="ALL">All statuses</option><option value="true">Active</option><option value="false">Inactive</option></select><button class="btn btn-primary">Filter</button></form>
<table class="data-table"><thead><tr><th>Product</th><th>Seller</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${products}" var="product"><tr><td><a href="${pageContext.request.contextPath}/admin/products/view?id=${product.id}">${product.name}</a></td><td>${product.sellerName}</td><td>${product.categoryName}</td><td>₹<fmt:formatNumber value="${product.price}" pattern="#,##0.00" /></td><td>${product.stock}</td><td><span class="card-badge-stock ${product.active ? 'in-stock' : 'out-of-stock'}" style="position:static;">${product.active ? 'ACTIVE' : 'INACTIVE'}</span></td><td><form method="post" action="${pageContext.request.contextPath}/admin/products/status"><input type="hidden" name="productId" value="${product.id}"><input type="hidden" name="active" value="${product.active ? 'false' : 'true'}"><button class="btn btn-sm ${product.active ? 'btn-danger' : 'btn-success'}">${product.active ? 'Deactivate' : 'Activate'}</button></form></td></tr></c:forEach></tbody></table>
</main><jsp:include page="/WEB-INF/views/common/footer.jsp" />
