<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="activeNav" value="admin" scope="request" /><jsp:include page="/WEB-INF/views/common/header.jsp" /><jsp:include page="/WEB-INF/views/common/navbar.jsp" />
<main class="main-content"><a href="${pageContext.request.contextPath}/admin/users" style="color:var(--accent-cyan);">← Users</a><c:choose><c:when test="${user != null}"><div class="modal-card" style="position:static;margin:1.5rem 0;width:min(650px,100%);"><h2 style="color:#fff;">User #${user.id}</h2><p><strong>Name:</strong> ${user.name}</p><p><strong>Email:</strong> ${user.email}</p><p><strong>Role:</strong> ${user.role}</p><p><strong>Status:</strong> ${user.active ? 'ACTIVE' : 'INACTIVE'}</p><p><strong>Created:</strong> <fmt:formatDate value="${user.createdAt}" pattern="yyyy-MM-dd HH:mm" /></p><c:if test="${user.role ne 'ADMIN'}"><form method="post" action="${pageContext.request.contextPath}/admin/users/status"><input type="hidden" name="userId" value="${user.id}"><input type="hidden" name="active" value="${user.active ? 'false' : 'true'}"><button class="btn ${user.active ? 'btn-danger' : 'btn-success'}">${user.active ? 'Deactivate' : 'Activate'} User</button></form></c:if></div></c:when><c:otherwise><p>User not found.</p></c:otherwise></c:choose></main><jsp:include page="/WEB-INF/views/common/footer.jsp" />
