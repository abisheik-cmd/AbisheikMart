<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="activeNav" value="admin" scope="request" /><jsp:include page="/WEB-INF/views/common/header.jsp" /><jsp:include page="/WEB-INF/views/common/navbar.jsp" />
<main class="main-content"><a href="${pageContext.request.contextPath}/admin/products" style="color:var(--accent-cyan);">← Products</a><c:choose><c:when test="${product != null}"><div class="modal-card" style="position:static;margin:1.5rem 0;width:min(700px,100%);"><h2 style="color:#fff;">${product.name}</h2><p>${product.description}</p><p><strong>Seller:</strong> ${product.sellerName} · <strong>Category:</strong> ${product.categoryName}</p><p><strong>Price:</strong> ₹<fmt:formatNumber value="${product.price}" pattern="#,##0.00" /> · <strong>Stock:</strong> ${product.stock}</p><p><strong>Status:</strong> ${product.active ? 'ACTIVE' : 'INACTIVE'}</p><form method="post" action="${pageContext.request.contextPath}/admin/products/status"><input type="hidden" name="productId" value="${product.id}"><input type="hidden" name="active" value="${product.active ? 'false' : 'true'}"><button class="btn ${product.active ? 'btn-danger' : 'btn-success'}">${product.active ? 'Deactivate' : 'Activate'} Product</button></form></div></c:when><c:otherwise><p>Product not found.</p></c:otherwise></c:choose></main><jsp:include page="/WEB-INF/views/common/footer.jsp" />
